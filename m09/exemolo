from pydantic import BaseModel, model_validator


class User(BaseModel):
    name: str
    idade: int
    is_admin: bool

    @model_validator(mode="after")
    def validate(self):
        if self.idade < 18 and self.is_admin == True:
            print("Menores de 18 nao pode ser administrador")
            exit(1)
        return self
    
user = User(
    name = "ana",
    idade = 17,
    is_admin= True)

print(user)